<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <Product>WhichCOM</Product>
    <Company>Yigisoft</Company>
    <Authors>Yigisoft</Authors>
    <Copyright>Copyright (c) 2026 Yigisoft</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    The widget package contains a self-contained build of comls. Its intermediate files are kept
    outside the project folder so that they do not disturb the normal build of the project.
  -->
  <PropertyGroup Condition="'$(ComlsForPackage)' == 'true' and '$(MSBuildProjectName)' == 'WhichCOM.Cli'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\comls\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\comls\</BaseOutputPath>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Keep local checkout paths (which may contain a user name) out of binaries and PDBs. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
