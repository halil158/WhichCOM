{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "$data": "${links}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "large"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "$when": "${hasDetail}",
              "text": "${detail}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${internet}",
      "color": "${internetColor}",
      "size": "small",
      "weight": "bolder",
      "spacing": "small"
    },
    {
      "type": "ColumnSet",
      "$data": "${audio}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "large"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "$when": "${hasDetail}",
              "text": "${detail}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        }
      ]
    }
  ]
}
