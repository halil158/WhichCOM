{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${internet}",
      "color": "${internetColor}",
      "size": "small",
      "weight": "bolder"
    },
    {
      "type": "ColumnSet",
      "$data": "${links}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "28px",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "medium"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "$when": "${hasDetail}",
              "text": "${detail}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "medium",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${audio}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "28px",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${icon}",
                  "size": "medium"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "bolder",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "$when": "${hasDetail}",
                  "text": "${detail}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
