{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "$data": "${ports}",
      "spacing": "medium",
      "selectAction": {
        "type": "Action.Execute",
        "verb": "copy",
        "tooltip": "${copyTitle}",
        "data": {
          "port": "${port}"
        }
      },
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "RichTextBlock",
              "inlines": [
                {
                  "type": "TextRun",
                  "text": "${port}",
                  "size": "large",
                  "weight": "bolder"
                },
                {
                  "type": "TextRun",
                  "$when": "${isNew}",
                  "text": "  ${$root.strings.new}",
                  "size": "small",
                  "weight": "bolder",
                  "color": "accent"
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "${label}",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "$when": "${isCopied}",
              "text": "${copiedText}",
              "color": "good",
              "size": "small",
              "weight": "bolder"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${hasMore}",
      "text": "${more}",
      "size": "small",
      "isSubtle": true,
      "spacing": "medium"
    },
    {
      "type": "TextBlock",
      "$when": "${isEmpty}",
      "text": "${strings.noDevice}",
      "size": "medium",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "Container",
      "$when": "${isEmpty}",
      "spacing": "medium",
      "selectAction": {
        "type": "Action.Execute",
        "verb": "deviceManager",
        "tooltip": "${strings.deviceManager}"
      },
      "items": [
        {
          "type": "TextBlock",
          "text": "${strings.deviceManager}",
          "color": "accent",
          "size": "small",
          "weight": "bolder"
        }
      ]
    }
  ]
}
