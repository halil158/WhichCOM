{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$data": "${ports}",
      "style": "${rowStyle}",
      "spacing": "small",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "RichTextBlock",
                  "inlines": [
                    {
                      "type": "TextRun",
                      "text": "${port}",
                      "size": "large",
                      "weight": "bolder"
                    },
                    {
                      "type": "TextRun",
                      "$when": "${isNew}",
                      "text": "  ${$root.strings.new}",
                      "size": "small",
                      "weight": "bolder",
                      "color": "accent"
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "text": "${label}",
                  "spacing": "none",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "$when": "${hasDetail}",
                  "text": "${detail}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "$when": "${hasSerial}",
                  "text": "${serial}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "type": "Action.Execute",
                      "title": "${copyTitle}",
                      "verb": "copy",
                      "data": {
                        "port": "${port}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${hasMore}",
      "text": "${more}",
      "size": "small",
      "isSubtle": true,
      "spacing": "medium"
    },
    {
      "type": "TextBlock",
      "$when": "${isEmpty}",
      "text": "${strings.noDevice}",
      "size": "medium",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "${strings.deviceManager}",
      "verb": "deviceManager"
    }
  ]
}
