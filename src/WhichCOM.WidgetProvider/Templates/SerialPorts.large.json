{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$data": "${ports}",
      "style": "${rowStyle}",
      "bleed": true,
      "spacing": "small",
      "selectAction": {
        "type": "Action.Execute",
        "verb": "copy",
        "tooltip": "${copyTitle}",
        "data": {
          "port": "${port}"
        }
      },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${port}",
                  "size": "large",
                  "weight": "bolder",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "text": "${label}",
                  "spacing": "none",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "$when": "${hasDetail}",
                  "text": "${detail}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "$when": "${hasSerial}",
                  "text": "${serial}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "$when": "${hasStatus}",
                  "text": "${status}",
                  "color": "${statusColor}",
                  "size": "small",
                  "weight": "bolder"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${hasMore}",
      "text": "${more}",
      "size": "small",
      "isSubtle": true,
      "spacing": "medium"
    },
    {
      "type": "TextBlock",
      "$when": "${isEmpty}",
      "text": "${strings.noDevice}",
      "size": "medium",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "ColumnSet",
      "separator": true,
      "spacing": "medium",
      "selectAction": {
        "type": "Action.Execute",
        "verb": "deviceManager",
        "tooltip": "${strings.deviceManager}"
      },
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${strings.deviceManager}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "text": "${strings.deviceManagerHint}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "›",
              "isSubtle": true
            }
          ]
        }
      ]
    }
  ]
}
