{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${internet}",
      "color": "${internetColor}",
      "size": "small",
      "weight": "bolder"
    },
    {
      "type": "ColumnSet",
      "$data": "${links}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "28px",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "medium"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "$when": "${hasDetail}",
              "text": "${detail}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "medium",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${audio}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "28px",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${icon}",
                  "size": "medium"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "bolder",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "$when": "${hasDetail}",
                  "text": "${detail}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "medium",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${serial.ports}",
          "spacing": "small",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "copy",
            "tooltip": "${copyTitle}",
            "data": {
              "port": "${port}"
            }
          },
          "columns": [
            {
              "type": "Column",
              "width": "28px",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${icon}",
                  "size": "medium"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${port}",
                  "weight": "bolder",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "text": "${label}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "$when": "${hasStatus}",
                  "text": "${status}",
                  "color": "${statusColor}",
                  "size": "small",
                  "weight": "bolder"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "$when": "${serial.isEmpty}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "28px",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serial.strings.portIcon}",
                  "size": "medium"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serial.strings.noDevice}",
                  "isSubtle": true,
                  "wrap": true
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "$when": "${serial.hasMore}",
          "text": "${serial.more}",
          "size": "small",
          "isSubtle": true,
          "spacing": "small"
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "deviceManager",
            "tooltip": "${serial.strings.deviceManager}"
          },
          "columns": [
            {
              "type": "Column",
              "width": "28px",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serial.strings.deviceManagerIcon}",
                  "size": "medium"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serial.strings.deviceManager}",
                  "weight": "bolder",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "text": "${serial.strings.deviceManagerHint}",
                  "size": "small",
                  "isSubtle": true,
                  "spacing": "none",
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
