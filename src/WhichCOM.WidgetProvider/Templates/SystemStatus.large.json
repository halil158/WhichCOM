{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "$data": "${links}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "large"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "$when": "${hasDetail}",
              "text": "${detail}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${internet}",
      "color": "${internetColor}",
      "size": "small",
      "weight": "bolder",
      "spacing": "small"
    },
    {
      "type": "ColumnSet",
      "$data": "${audio}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "large"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "wrap": false
            },
            {
              "type": "TextBlock",
              "$when": "${hasDetail}",
              "text": "${detail}",
              "size": "small",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${serial.strings.title}",
      "size": "small",
      "weight": "bolder",
      "isSubtle": true,
      "separator": true,
      "spacing": "medium"
    },
    {
      "type": "ColumnSet",
      "$data": "${serial.ports}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "RichTextBlock",
              "inlines": [
                {
                  "type": "TextRun",
                  "text": "${port}",
                  "size": "large",
                  "weight": "bolder"
                },
                {
                  "type": "TextRun",
                  "$when": "${isNew}",
                  "text": "  ${$root.serial.strings.new}",
                  "size": "small",
                  "weight": "bolder",
                  "color": "accent"
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "${label}",
              "isSubtle": true,
              "spacing": "none",
              "wrap": false
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Execute",
                  "title": "${copyTitle}",
                  "verb": "copy",
                  "data": {
                    "port": "${port}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${serial.hasMore}",
      "text": "${serial.more}",
      "size": "small",
      "isSubtle": true,
      "spacing": "small"
    },
    {
      "type": "TextBlock",
      "$when": "${serial.isEmpty}",
      "text": "${serial.strings.noDevice}",
      "isSubtle": true,
      "spacing": "small",
      "wrap": true
    }
  ]
}
