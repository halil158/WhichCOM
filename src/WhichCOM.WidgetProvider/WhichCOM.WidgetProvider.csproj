<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>WhichCOM.WidgetProvider</RootNamespace>
    <AssemblyName>WhichCOM.WidgetProvider</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Description>Windows 11 widget provider that shows serial ports and system status.</Description>
  </PropertyGroup>

  <!-- MSIX package. The build never signs; scripts/Build-Package.ps1 signs with a local certificate. -->
  <PropertyGroup>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- The package brings its own .NET and Windows App SDK files, so nothing else has to be installed. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedNativeWifi" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhichCOM.Core\WhichCOM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ProviderAssets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Templates\*.json" LogicalName="WhichCOM.WidgetProvider.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    comls is part of the package; an execution alias in the manifest puts it on the PATH.
    It is built for the same runtime as the provider and uses the .NET files of the package.
  -->
  <Target Name="IncludeComls" BeforeTargets="AssignTargetPaths" Condition="'$(IncludeComls)' != 'false'">
    <PropertyGroup>
      <_ComlsProject>$(MSBuildProjectDirectory)\..\WhichCOM.Cli\WhichCOM.Cli.csproj</_ComlsProject>
      <_ComlsPublishDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)comls\$(Configuration)\$(RuntimeIdentifier)\</_ComlsPublishDir>
      <_ComlsProperties>ComlsForPackage=true;Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(_ComlsPublishDir)</_ComlsProperties>
    </PropertyGroup>

    <MSBuild Projects="$(_ComlsProject)" Targets="Restore" Properties="$(_ComlsProperties);_ComlsStep=Restore" />
    <MSBuild Projects="$(_ComlsProject)" Targets="Publish" Properties="$(_ComlsProperties)" />

    <ItemGroup>
      <Content Include="$(_ComlsPublishDir)comls.exe" Link="comls.exe" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(_ComlsPublishDir)comls.dll" Link="comls.dll" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(_ComlsPublishDir)comls.deps.json" Link="comls.deps.json" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(_ComlsPublishDir)comls.runtimeconfig.json" Link="comls.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
