#!/bin/sh
# Scans the staged changes for secrets and personal data before every commit.
# Enable once per clone:  git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
    if [ "$WHICHCOM_SKIP_GITLEAKS" = "1" ]; then
        echo "pre-commit: gitleaks not found, scan skipped (WHICHCOM_SKIP_GITLEAKS=1)." >&2
        exit 0
    fi

    echo "pre-commit: gitleaks is not installed, commit blocked." >&2
    echo "  Install it:   winget install Gitleaks.Gitleaks" >&2
    echo "  Or skip once: WHICHCOM_SKIP_GITLEAKS=1 git commit ..." >&2
    exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner; then
    echo "pre-commit: gitleaks found a secret or personal data in the staged changes." >&2
    echo "  Remove it and stage again. See CONTRIBUTING.md for false positives." >&2
    exit 1
fi
