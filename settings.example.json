{
  // Copy this file to %LOCALAPPDATA%\WhichCOM\settings.json and edit it.
  // All values below are examples.

  "aliases": [
    // A device with a serial number: identify it by the serial number.
    { "serial": "EXAMPLE0001", "name": "Sensor board #2" },

    // Cheap adapters often share a serial number such as "0001"; add vidPid to tell them apart.
    { "serial": "0001", "vidPid": "10C4:EA60", "name": "Gateway" },

    // A device without a serial number: identify it by VID:PID and the USB socket it is plugged into.
    // 'comls --json' prints the locationPath of every port.
    { "vidPid": "1A86:7523", "location": "PCIROOT(0)#PCI(1400)#USBROOT(0)#USB(3)", "name": "Bench CH340" }
  ],

  // Language of the widgets: "auto" follows the display language of Windows, or use "en" / "tr".
  "language": "auto",

  // Bluetooth serial ports are hidden by default.
  "showBluetoothPorts": false,

  // Exact Wi-Fi network name and signal percentage. Windows asks for location access when this
  // is on. When off, the name of the network profile and the signal in bars are shown.
  "useWifiApi": false,

  // How long a freshly plugged port is marked as new.
  "newBadgeSeconds": 120,

  // Refresh interval while the widget board is open.
  "refreshSeconds": 4
}
